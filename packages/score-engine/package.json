{
  "name": "@ocs/score-engine",
  "version": "0.0.1",
  "private": true,
  "description": "Source-agnostic cricket scoring engine with PWA WebSocket and PCS Pro file-watcher adapters",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/reducer.test.ts"
  },
  "dependencies": {
    "@ocs/db": "*",
    "better-sqlite3": "^11.5.0",
    "chokidar": "^4.0.1",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
