# HTTP + WebSocket port for the score engine
PORT=8080

# Path to the SQLite event log
DB_PATH=./var/match.sqlite

# PCS Pro file-watcher: directory where PCS Pro writes its template output
# On the Pi this is the Samba share mount point (e.g. /srv/score-in)
PCS_PRO_WATCH_DIR=./var/score-in

# Where the overlay renderer writes state.json (and later overlay.png)
OVERLAY_OUT_DIR=./var/overlay-out

# CORS origins for the WebSocket (comma-separated). "*" for dev.
CORS_ORIGIN=*

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Supabase mirror (optional — leave blank to run SQLite-only).
# The score-engine writes the durable mirror with the SERVICE ROLE key.
# Never put this key in any browser-shipped code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
