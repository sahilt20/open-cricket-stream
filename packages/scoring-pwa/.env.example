# WebSocket URL for the score-engine on the Pi.
# In dev: http://localhost:8080
# On the Pi's AP: http://10.42.0.1:8080 (or whatever Pi IP is configured)
VITE_ENGINE_URL=http://localhost:8080

# Supabase (durable data — fixtures, teams, players, history). Optional in dev:
# without these the PWA falls back to "live-only" mode and shows a banner.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
