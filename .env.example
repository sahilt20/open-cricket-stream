# Root .env for docker-compose. Copy to .env and edit.
#
# All variables are optional — the stack runs with sensible defaults.

# ── Image tag (e.g. local, dev, v0.1.0) ──────────────────────────────────────
TAG=local
REGISTRY=ghcr.io/sahilt20

# ── Host port mappings (change if you have port conflicts) ───────────────────
ENGINE_PORT=8080
PWA_PORT=5173
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
SMB_PORT=1445

# ── Score-engine ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
CORS_ORIGIN=*

# Supabase mirror (durable tier). Leave blank for SQLite-only mode.
# When using `supabase start`, the URL is http://host.docker.internal:54321
# (or the supabase CLI prints the right URL on `supabase status`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Scoring PWA build-time args (baked into the image at build) ──────────────
# When the PWA runs in the container, the browser fetches the engine via
# the host port mapping, so VITE_ENGINE_URL points at localhost:ENGINE_PORT.
VITE_ENGINE_URL=http://localhost:8080
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── FFmpeg compositor (only used with `--profile stream`) ────────────────────
# OUTPUT_URL options:
#   file:///out/local.mp4               — local recording (default)
#   rtmps://a.rtmp.youtube.com/live2/<KEY>  — push to YouTube
OUTPUT_URL=file:///out/local.mp4
# libx264 on dev boxes; h264_v4l2m2m on the Pi 5
VIDEO_CODEC=libx264
